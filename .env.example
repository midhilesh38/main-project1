# Copy this file to backend/.env (and fill in DATABASE_URL) for local dev.
DATABASE_URL=
JWT_SECRET=pec-repair-super-secret-jwt-key-2026
PORT=5000

# Frontend (frontend/.env) — usually not needed for local dev: the Vite dev
# server (frontend/vite.config.js) already proxies /api to
# http://localhost:5000 automatically. Only set this if your backend runs on
# a different host/port.
# VITE_BACKEND_URL=http://localhost:5000


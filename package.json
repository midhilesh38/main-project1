{
  "name": "pec-repair-desk",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "backend",
    "frontend",
    "database"
  ],
  "scripts": {
    "dev": "npm --workspace=frontend run build && node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('frontend/dist','dist',{recursive:true});\" && node server.js",
    "build": "npm --workspace=frontend run build && node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('frontend/dist','dist',{recursive:true});\"",
    "start": "node server.js",
    "test": "npm --workspace=backend run test && npm --workspace=frontend run test",
    "lint": "npm --workspace=backend run lint"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3"
  }
}
